DATABASE_URL=sqlite:///./stocklog.db

# MySQL connection-pool stability for long-running sync + UI/background workers
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT_SECONDS=8
DB_POOL_RECYCLE_SECONDS=1800
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://somensomes.iptime.org:8100,http://somensomes.iptime.org:3000

# 서버 공용 관리자 데이터 동기화에 사용할 키움 REST API 키 (선택)
KIWOOM_ADMIN_APP_KEY=
KIWOOM_ADMIN_SECRET_KEY=

# 뉴스 검색 (선택)

# OpenDART fallback (권장: 관리자 페이지에서 저장)
DART_API_KEY=

# 동기화 재실행 최소 간격
SYNC_COOLDOWN_SECONDS=60

# 키움 모의계좌 강제 호출 최소 간격(일반 조회는 캐시 사용)
KIWOOM_ACCOUNT_SYNC_MIN_INTERVAL_SECONDS=20

# v3.40 외부 API fallback 설정
# 권장: 관리자 > 외부 API 관리에서 MySQL 암호화 저장. 아래 값은 DB 설정이 없을 때만 사용됩니다.
# NAVER API HUB: X-NCP-APIGW-API-KEY-ID
NAVER_CLIENT_ID=
# NAVER API HUB: X-NCP-APIGW-API-KEY
NAVER_CLIENT_SECRET=
# 15분 캐시: 상세화면에서 강제 갱신 버튼으로 즉시 갱신 가능
NEWS_CACHE_SECONDS=900
NEWS_DISPLAY_COUNT=20
# 증권사 리포트는 6시간 캐시
BROKER_REPORT_CACHE_SECONDS=21600
BROKER_REPORT_COUNT=10
# OpenDART 공식 공시
DISCLOSURE_CACHE_SECONDS=900
DISCLOSURE_LOOKBACK_DAYS=120
DISCLOSURE_DISPLAY_COUNT=20

# Gemini Gbot model selection (404/model-unavailable auto fallback)
GEMINI_MANUAL_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash
STOCKLOG_MOBILE_RETURN_URL=stocklog://auth
