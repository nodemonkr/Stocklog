# StockLog root network configuration
# cp .env.example .env

STOCKLOG_BIND_HOST=0.0.0.0
STOCKLOG_FRONTEND_PORT=5174
STOCKLOG_BACKEND_PORT=8100
STOCKLOG_PUBLIC_HOST=somensomes.iptime.org
STOCKLOG_PUBLIC_PORT=3000
STOCKLOG_ALLOWED_HOSTS=


# StockLog local AI Bot
AI_ANALYST_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# i5-6500T / 19GiB RAM baseline
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=520
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=10m

# Expensive CPU AI results are cached in MySQL.
AI_ANALYSIS_CACHE_HOURS=3
AI_BATCH_MAX_STOCKS=10

# Fast CPU AI pipeline
AI_INCLUDE_LIVE_REPORTS=false
AI_INCLUDE_MARKET_CONTEXT=true

# v3.40 Market Intelligence / .env fallback only
# NAVER API HUB: X-NCP-APIGW-API-KEY-ID
NAVER_CLIENT_ID=
# NAVER API HUB: X-NCP-APIGW-API-KEY
NAVER_CLIENT_SECRET=
NEWS_CACHE_SECONDS=900
NEWS_DISPLAY_COUNT=20
BROKER_REPORT_CACHE_SECONDS=21600
BROKER_REPORT_COUNT=10
DISCLOSURE_CACHE_SECONDS=900
DISCLOSURE_LOOKBACK_DAYS=120
DISCLOSURE_DISPLAY_COUNT=20

# Premium portfolio AI momentum cache (hours)
PORTFOLIO_AI_MOMENTUM_CACHE_HOURS=4

# v3.56 dual AI consensus stage limits (seconds)
AI_ENSEMBLE_GEMINI_TIMEOUT_SECONDS=50
AI_ENSEMBLE_OLLAMA_TIMEOUT_SECONDS=85
AI_ENSEMBLE_SYNTHESIS_TIMEOUT_SECONDS=50

# v3.73.2 premium AI live streaming
# Obot interactive analysis uses streaming and has no short HTTP read timeout.
# This is only a last-resort hard safety guard for a truly wedged local process.
AI_OBOT_HARD_LIMIT_SECONDS=600
AI_GBOT_FINAL_TIMEOUT_SECONDS=120
OBOT_FAST_NUM_PREDICT=280
OBOT_FAST_NUM_CTX=1792
OBOT_RETRY_NUM_PREDICT=190
OBOT_RETRY_NUM_CTX=1280

# Gemini Gbot model selection (404/model-unavailable auto fallback)
GEMINI_MANUAL_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-2.5-flash-lite,gemini-2.5-flash

# MySQL connection-pool stability for long-running sync + UI/background workers
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT_SECONDS=8
DB_POOL_RECYCLE_SECONDS=1800

# Installed mobile app OAuth callback (fixed deep link)
STOCKLOG_MOBILE_RETURN_URL=stocklog://auth
STOCKLOG_MOBILE_BACKEND_PORT=8100
STOCKLOG_MOBILE_FALLBACK_PORT=3000
